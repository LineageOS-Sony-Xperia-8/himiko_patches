Subject: [PATCH] hardware/qcom-caf/bootctrl: physical ab
Base-commit: 846dfb0652cc142e1783cbe085783527bbe4a190

diff --git a/1.1/libboot_control_qti/libboot_control_qti.cpp b/1.1/libboot_control_qti/libboot_control_qti.cpp
index b728e74..5f53b1c 100644
--- a/1.1/libboot_control_qti/libboot_control_qti.cpp
+++ b/1.1/libboot_control_qti/libboot_control_qti.cpp
@@ -32,6 +32,7 @@
 
 #include <libboot_control_qti.h>
 
+#include <initializer_list>
 #include <map>
 #include <memory>
 #include <list>
@@ -96,6 +97,20 @@ using ::android::hardware::boot::V1_1::MergeStatus;
 
 unsigned int kMaxNumSlots = 2;
 
+static std::initializer_list<const char *> get_ab_partition_names()
+{
+	static constexpr std::initializer_list<const char *> qti_partitions = { AB_PTN_LIST };
+	// Match bootctrl.sdm660.so from Sony 56.1.C.3.231 and the Himiko partition table.
+	static constexpr std::initializer_list<const char *> himiko_partitions = {
+		"abl", "cmnlib", "cmnlib64", "devcfg", "hyp", "keymaster", "tz",
+		"tzxfl", "tzxflattest", "xbl", "xfl", "boot", "system", "vendor",
+		"modem", "bluetooth", "rdimage", "oem", "dsp", "rpm", "pmic", "vbmeta", "dtbo",
+	};
+	char device[PROPERTY_VALUE_MAX];
+	property_get("ro.product.device", device, "");
+	return !strcmp(device, "himiko") ? himiko_partitions : qti_partitions;
+}
+
 //Get the value of one of the attribute fields for a partition.
 static int get_partition_attribute(char *partname,
 		enum part_attr_type part_attr)
@@ -135,8 +150,10 @@ enum part_stat_result_type stat_block_device(const char *dev_path)
 {
 	struct stat st;
 	if (lstat(dev_path, &st)) {
-		// Partition could not be found
-		return PARTITION_MISSING;
+		if (errno == ENOENT)
+			return PARTITION_MISSING;
+		ALOGE("Unable to stat partition link: %s, %s", dev_path, strerror(errno));
+		return PARTITION_STAT_ERROR;
 	}
 	errno = 0;
 	if (stat(dev_path, &st)) {
@@ -146,7 +163,7 @@ enum part_stat_result_type stat_block_device(const char *dev_path)
 		ALOGE("Unable to stat block device: %s, %s",
 			dev_path,
 			strerror(errno));
-		return PARTITION_MISSING;
+		return PARTITION_STAT_ERROR;
 	}
 	return PARTITION_FOUND;
 }
@@ -164,7 +181,6 @@ static int update_slot_attribute(const char *slot,
 	uint8_t *attr_bak = NULL;
 	std::unique_ptr<struct gpt_disk, decltype(&gpt_disk_free)> disk_raii(nullptr, &gpt_disk_free);
 	char partName[MAX_GPT_NAME_SIZE + 1] = {0};
-	const char ptn_list[][MAX_GPT_NAME_SIZE] = { AB_PTN_LIST };
 	int slot_name_valid = 0;
 	if (!slot) {
 		ALOGE("%s: Invalid argument", __func__);
@@ -180,13 +196,13 @@ static int update_slot_attribute(const char *slot,
 		ALOGE("%s: Invalid slot name", __func__);
 		return -1;
 	}
-	for (i=0; i < ARRAY_SIZE(ptn_list); i++) {
+	for (const char *partition : get_ab_partition_names()) {
 		memset(buf, '\0', sizeof(buf));
 		//Check if A/B versions of this ptn exist
 		snprintf(buf, sizeof(buf) - 1,
                                         "%s/%s%s",
                                         BOOT_DEV_DIR,
-                                        ptn_list[i],
+                                        partition,
 					AB_SLOT_A_SUFFIX
 					);
 		enum part_stat_result_type stat_result = stat_block_device(buf);
@@ -200,7 +216,7 @@ static int update_slot_attribute(const char *slot,
 		snprintf(buf, sizeof(buf) - 1,
                                         "%s/%s%s",
                                         BOOT_DEV_DIR,
-                                        ptn_list[i],
+                                        partition,
 					AB_SLOT_B_SUFFIX
 					);
 		stat_result = stat_block_device(buf);
@@ -214,7 +230,7 @@ static int update_slot_attribute(const char *slot,
 		snprintf(partName,
 				sizeof(partName) - 1,
 				"%s%s",
-				ptn_list[i],
+				partition,
 				slot);
 		disk_raii = std::unique_ptr<struct gpt_disk, decltype(&gpt_disk_free)>(
 			gpt_disk_alloc(), &gpt_disk_free);
@@ -630,8 +646,6 @@ int set_active_boot_slot(unsigned slot)
 	}
 	map<string, vector<string>> ptn_map;
 	vector<string> ptn_vec;
-	const char ptn_list[][MAX_GPT_NAME_SIZE] = { AB_PTN_LIST };
-	uint32_t i;
 	int rc = -1;
 	int is_ufs = gpt_utils_is_ufs_device();
 	map<string, vector<string>>::iterator map_iter;
@@ -644,17 +658,17 @@ int set_active_boot_slot(unsigned slot)
 	//partitions that support A/B. In order to get the layout we need the
 	//actual names. To do this we append the slot suffix to every member
 	//in the list.
-	for (i = 0; i < ARRAY_SIZE(ptn_list); i++) {
+	for (const char *partition : get_ab_partition_names()) {
 		//XBL, XBL_CFG, MULTIIMGOEM, MULTIIMGQTI are handled differrently
                //for ufs devices so ignore them.
-		if (is_ufs && (!strcmp(ptn_list[i],PTN_XBL)
-		    || !strcmp(ptn_list[i],PTN_XBL_CFG)
-                    || !strcmp(ptn_list[i],PTN_MULTIIMGOEM)
-                    || !strcmp(ptn_list[i],PTN_MULTIIMGQTI)))
+		if (is_ufs && (!strcmp(partition, PTN_XBL)
+		    || !strcmp(partition, PTN_XBL_CFG)
+		    || !strcmp(partition, PTN_MULTIIMGOEM)
+		    || !strcmp(partition, PTN_MULTIIMGQTI)))
 				continue;
 		//The partition list will be the list of partitions
 		//corresponding to the slot being set active
-		string cur_ptn = ptn_list[i];
+		string cur_ptn = partition;
 		cur_ptn.append(slot_suffix_arr[slot]);
 		ptn_vec.push_back(cur_ptn);
 
@@ -700,6 +714,10 @@ int set_active_boot_slot(unsigned slot)
 			return -1;
 		}
 	}
+	if (get_active_boot_slot() != static_cast<int>(slot)) {
+		ALOGE("%s: Could not confirm that slot %u is active", __func__, slot);
+		return -1;
+	}
 	return 0;
 }
 
@@ -804,24 +822,20 @@ MergeStatus get_snapshot_merge_status()
 
 int get_active_boot_slot()
 {
-	int slot = 0;
+	int slot = -1;
 	char bootPartition[MAX_GPT_NAME_SIZE + 1] = {0};
-
-	for (int i = 0; slot_suffix_arr[i] != NULL; i++) {
+	for (unsigned i = 0; slot_suffix_arr[i] != NULL &&
+			boot_control_check_slot_sanity(i) == 0; i++) {
 		snprintf(bootPartition, sizeof(bootPartition) - 1,
 			"boot%s", slot_suffix_arr[i]);
 
-			if (get_partition_attribute(bootPartition,
-				ATTR_SLOT_ACTIVE) == 1) {
-				slot = i;
-				break;
-			}
-	}
-
-	if (boot_control_check_slot_sanity(slot) != 0) {
-		ALOGE("%s: Failed to validate active slot configuration", __func__);
-		return -1;
-	} else {
-		return slot;
+		int active = get_partition_attribute(bootPartition, ATTR_SLOT_ACTIVE);
+		if (active < 0 || (active == 1 && slot != -1)) {
+			ALOGE("%s: Invalid active flag for %s", __func__, bootPartition);
+			return -1;
+		}
+		if (active == 1)
+			slot = i;
 	}
+	return slot;
 }
diff --git a/aidl/BootControl.cpp b/aidl/BootControl.cpp
index 32be1ac..b5dc670 100644
--- a/aidl/BootControl.cpp
+++ b/aidl/BootControl.cpp
@@ -40,13 +40,12 @@ BootControl::BootControl() {
 }
 
 ScopedAStatus BootControl::getActiveBootSlot(int32_t* _aidl_return) {
-    int32_t ret  = get_active_boot_slot();
-    if (ret < 0){
-        *_aidl_return = 0;
-    }
-    else {
-        *_aidl_return = ret;
+    int32_t ret = get_active_boot_slot();
+    if (ret < 0) {
+        return ScopedAStatus::fromServiceSpecificErrorWithMessage(
+                COMMAND_FAILED, "Unable to determine the active boot slot");
     }
+    *_aidl_return = ret;
     return ScopedAStatus::ok();
 }
 
