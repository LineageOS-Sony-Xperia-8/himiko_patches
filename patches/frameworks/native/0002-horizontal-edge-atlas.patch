+++ b/libs/renderengine/skia/filters/EdgeExtensionShaderFactory.cpp
@@ -17,6 +17,8 @@
 #include "EdgeExtensionShaderFactory.h"
 #include <SkPoint.h>
 #include <SkRuntimeEffect.h>
+#include <SkSamplingOptions.h>
+#include <SkTileMode.h>
 #include <SkStream.h>
 #include <SkString.h>
 #include <com_android_graphics_libgui_flags.h>
@@ -59,8 +61,26 @@ const SkString kEffectSource_EdgeExtensionEffect(R"(
     }
 )");
 
+const SkString kEffectSource_HorizontalEdgeExtensionEffect(R"(
+    uniform shader uContentTexture;
+    uniform shader uEdgeTexture;
+    uniform vec2 uImgSize;
+    uniform vec2 uContentOffset;
+
+    vec4 main(vec2 coord) {
+        vec2 nearestTexturePoint = clamp(coord, vec2(0, 0), uImgSize);
+        if (coord == nearestTexturePoint) {
+            // Keep explicit fragment sampling, matching the original 49-tap child's usage.
+            return uContentTexture.eval(coord + uContentOffset);
+        } else {
+            return uEdgeTexture.eval(vec2(coord.x < 0 ? 0.5 : 1.5, coord.y));
+        }
+    }
+)");
+
 EdgeExtensionShaderFactory::EdgeExtensionShaderFactory(RuntimeEffectManager& effectManager) {
     mEffect = effectManager.mKnownEffects[kEdgeExtensionEffect];
+    mHorizontalEffect = effectManager.mKnownEffects[kHorizontalEdgeExtensionEffect];
 }
 
 sk_sp<SkShader> EdgeExtensionShaderFactory::createSkShader(const sk_sp<SkShader>& inputShader,
@@ -77,4 +97,16 @@ sk_sp<SkShader> EdgeExtensionShaderFactory::createSkShader(const sk_sp<SkShader>
     }
     return builder.makeShader();
 }
+sk_sp<SkShader> EdgeExtensionShaderFactory::createFromHorizontalStrips(
+        const sk_sp<SkShader>& inputShader, const sk_sp<SkImage>& strips,
+        const SkRect& imageBounds) const {
+    SkRuntimeShaderBuilder builder(mHorizontalEffect);
+    builder.child("uContentTexture") = inputShader;
+    builder.child("uEdgeTexture") = strips->makeShader(SkTileMode::kClamp, SkTileMode::kClamp,
+                                                     SkSamplingOptions());
+    builder.uniform("uImgSize") = SkPoint{imageBounds.width(), imageBounds.height()};
+    builder.uniform("uContentOffset") = SkPoint{0.f, 0.f};
+    return builder.makeShader();
+}
+
 } // namespace android::renderengine::skia
