diff --git a/libs/renderengine/skia/Cache.cpp b/libs/renderengine/skia/Cache.cpp
index a719aaf..0f41e26 100644
--- a/libs/renderengine/skia/Cache.cpp
+++ b/libs/renderengine/skia/Cache.cpp
@@ -708,6 +708,34 @@ static void drawP3ImageLayers(SkiaRenderEngine* renderengine, const DisplaySetti
     }
 }
 
+static void drawHorizontalEdgeExtensionLayers(
+        SkiaRenderEngine* renderengine, const DisplaySettings& display,
+        const std::shared_ptr<ExternalTexture>& dstTexture,
+        const std::shared_ptr<ExternalTexture>& srcTexture) {
+    if (srcTexture->getPixelFormat() != PIXEL_FORMAT_RGBA_8888) return;
+    const float width = srcTexture->getWidth();
+    const float height = srcTexture->getHeight();
+    const float extension = width / 4.f;
+    auto edgeDisplay = display;
+    edgeDisplay.outputDataspace = ui::Dataspace::V0_SRGB;
+    edgeDisplay.targetLuminanceNits = -1.f;
+    edgeDisplay.dimmingStage = aidl::android::hardware::graphics::composer3::DimmingStage::NONE;
+    LayerSettings layer;
+    layer.geometry.boundaries = FloatRect(-extension, 0.f, width, height);
+    layer.geometry.positionTransform = mat4::translate(vec4(3.25f, 0.f, 0.f, 1.f));
+    layer.source.buffer.buffer = srcTexture;
+    layer.source.buffer.isOpaque = true;
+    layer.source.buffer.useTextureFiltering = true;
+    layer.source.buffer.textureTransform = mat4::translate(vec4(-0.25f, 0.f, 0.f, 1.f)) *
+            mat4::scale(vec4(1.25f, 1.f, 1.f, 1.f));
+    layer.sourceDataspace = ui::Dataspace::V0_SRGB;
+    layer.edgeExtensionEffect = EdgeExtensionEffect(true, false, false, false);
+    for (float alpha : {0.5f, 1.f}) {
+        layer.alpha = alpha;
+        renderengine->drawLayers(edgeDisplay, {layer}, dstTexture, base::unique_fd());
+    }
+}
+
 static void drawEdgeExtensionLayers(SkiaRenderEngine* renderengine, const DisplaySettings& display,
                                     const std::shared_ptr<ExternalTexture>& dstTexture,
                                     const std::shared_ptr<ExternalTexture>& srcTexture) {
@@ -1002,6 +1030,7 @@ void Cache::primeShaderCache(SkiaRenderEngine* renderengine, PrimeCacheConfig co
                 SFTRACE_NAME("cacheEdgeExtension");
                 drawEdgeExtensionLayers(renderengine, display, dstTexture, texture);
                 drawEdgeExtensionLayers(renderengine, p3Display, dstTexture, texture);
+                drawHorizontalEdgeExtensionLayers(renderengine, display, dstTexture, texture);
             }
         }
 
