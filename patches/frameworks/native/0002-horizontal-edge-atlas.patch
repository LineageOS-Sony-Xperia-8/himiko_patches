+
             paint.setShader(createRuntimeEffectShader(RuntimeEffectShaderParameters{
                     .shader = shader,
                     .layer = layer,
@@ -1234,6 +1251,69 @@ void SkiaRenderEngine::drawLayersInternal(
                     .imageBounds = imageBounds,
             }));
 
+            if (layer.edgeExtensionEffect.hasEffect() && item.isOpaque &&
+                item.useTextureFiltering) {
+                // Horizontal extension repeats the same 49-tap edge sample at every outside
+                // pixel in a row. Precompute both columns for this draw, retaining the original
+                // single-rectangle clamp decision and explicit fragment sampling coordinates.
+                const auto& edges = layer.edgeExtensionEffect;
+                const auto& rect = bounds.rect();
+                const auto& deviceMatrix = canvas->getTotalMatrix();
+                const auto destinationInfo = activeSurface->imageInfo();
+                const auto* recordingContext = activeSurface->recordingContext();
+                const bool canPrecomputeHorizontalExtension =
+                        recordingContext && recordingContext->backend() == GrBackendApi::kOpenGL &&
+                        layer.sourceDataspace == ui::Dataspace::V0_SRGB &&
+                        display.outputDataspace == ui::Dataspace::V0_SRGB && rect.isFinite() &&
+                        std::isfinite(deviceMatrix.getTranslateX()) &&
+                        std::isfinite(deviceMatrix.getTranslateY()) && edges.hasEffect() &&
+                        !edges.extendsEdge(TOP) && !edges.extendsEdge(BOTTOM) &&
+                        (rect.left() < 0.f || rect.right() > image->width()) &&
+                        (rect.left() >= 0.f || edges.extendsEdge(LEFT)) &&
+                        (rect.right() <= image->width() || edges.extendsEdge(RIGHT)) &&
+                        bounds.isRect() && roundRectClip.isEmpty() && rect.top() == 0.f &&
+                        rect.bottom() == image->height() && matrix.isIdentity() &&
+                        deviceMatrix.isTranslate() &&
+                        std::floor(deviceMatrix.getTranslateY()) == deviceMatrix.getTranslateY() &&
+                        image->width() > 36 && item.isOpaque && item.useTextureFiltering &&
+                        !useIsOpaqueWorkaround && !requiresLinearEffect && !isProtected() &&
+                        !layer.stretchEffect.hasEffect() && !layer.luts &&
+                        !mCapture->isCaptureRunning() &&
+                        (image->colorType() == kRGBA_8888_SkColorType ||
+                         image->colorType() == kRGB_888x_SkColorType) &&
+                        destinationInfo.colorType() == kRGBA_8888_SkColorType &&
+                        SkColorSpace::Equals(image->colorSpace(), destinationInfo.colorSpace());
+                if (canPrecomputeHorizontalExtension) {
+                    auto stripInfo = destinationInfo.makeWH(2, image->height())
+                                             .makeColorType(kRGBA_F16_SkColorType)
+                                             .makeAlphaType(kPremul_SkAlphaType);
+                    auto stripSurface = context->createRenderTarget(stripInfo);
+                    if (stripSurface) {
+                        auto* stripCanvas = stripSurface->getCanvas();
+                        SkPaint stripPaint;
+                        stripPaint.setBlendMode(SkBlendMode::kSrc);
+                        stripPaint.setShader(paint.refShader());
+                        for (bool left : {true, false}) {
+                            SkAutoCanvasRestore restore(stripCanvas, true);
+                            const float x = left ? -1.f : static_cast<float>(image->width());
+                            stripCanvas->translate((left ? 0.f : 1.f) - x, 0.f);
+                            stripCanvas->drawRect(SkRect::MakeXYWH(x, 0.f, 1.f, image->height()),
+                                                  stripPaint);
+                        }
+                        auto strips = stripSurface->makeImageSnapshot();
+                        if (strips) {
+                            auto combined = mEdgeExtensionShaderFactory.createFromHorizontalStrips(
+                                    shader, strips, imageBounds);
+                            if (combined) {
+                                SFTRACE_NAME("PrepareHorizontalEdgeStrips");
+                                paint.setShader(std::move(combined));
+                            }
+                        }
+                    }
+                }
+
+            }
+
             // Turn on dithering when dimming beyond this (arbitrary) threshold...
             static constexpr float kDimmingThreshold = 0.9f;
             // ...or we're rendering an HDR layer down to an 8-bit target
