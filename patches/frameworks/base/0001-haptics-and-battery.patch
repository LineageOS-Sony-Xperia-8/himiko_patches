     }
 
     /**
@@ -72,8 +77,23 @@ public class VibratorHelper {
      */
     @VisibleForTesting
     public VibratorHelper(@Nullable Vibrator vibrator, Executor executor) {
+        this(vibrator, executor, 0);
+    }
+
+    private VibratorHelper(@Nullable Vibrator vibrator, Executor executor,
+            int sliderPulseDurationMillis) {
         mExecutor = executor;
         mVibrator = vibrator;
+        mSliderHapticFallback = sliderPulseDurationMillis > 0
+                && vibrator != null && vibrator.hasVibrator() && !vibrator.hasAmplitudeControl()
+                ? VibrationEffect.createOneShot(sliderPulseDurationMillis,
+                        VibrationEffect.DEFAULT_AMPLITUDE)
+                : null;
+    }
+
+    @Nullable
+    public VibrationEffect getSliderHapticFallback() {
+        return mSliderHapticFallback;
     }
 
