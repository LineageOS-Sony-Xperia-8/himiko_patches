Subject: [PATCH] frameworks/base: postdraw sync
Base-commit: 4617d71eb23447fb325178ac34a0fd7daa1b0597

diff --git a/core/java/android/view/ViewRootImpl.java b/core/java/android/view/ViewRootImpl.java
index fa1c190eb..2b9c79a36 100644
--- a/core/java/android/view/ViewRootImpl.java
+++ b/core/java/android/view/ViewRootImpl.java
@@ -5573,6 +5573,7 @@ public final class ViewRootImpl implements ViewParent,
         addFrameCommitCallbackIfNeeded();
 
         boolean usingAsyncReport;
+        final boolean reportNextDrawAtStart = mReportNextDraw;
 
         try {
             usingAsyncReport = draw(fullRedrawNeeded, surfaceSyncGroup, mSyncBuffer);
@@ -5614,7 +5615,10 @@ public final class ViewRootImpl implements ViewParent,
                 mWindowDrawCountDown = null;
             }
 
-            if (mAttachInfo.mThreadedRenderer != null) {
+            // Hardware draw already resumed rendering for this report. Avoid another
+            // synchronous RenderThread round trip unless its stopped state needs restoring.
+            if (mAttachInfo.mThreadedRenderer != null
+                    && (!usingAsyncReport || mStopped || !reportNextDrawAtStart)) {
                 mAttachInfo.mThreadedRenderer.setStopped(mStopped);
             }
 
