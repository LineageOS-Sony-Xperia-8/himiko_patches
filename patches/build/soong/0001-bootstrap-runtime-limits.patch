Subject: [PATCH] build/soong: bootstrap runtime limits
Base-commit: 9aa045a2aef10b8089e32e847fed26d9aa3d61be

diff --git a/ui/build/soong.go b/ui/build/soong.go
index c9b303c..259d367 100644
--- a/ui/build/soong.go
+++ b/ui/build/soong.go
@@ -226,6 +226,12 @@ func (pb PrimaryBuilderFactory) primaryBuilderInvocation(config Config) bootstra
 
 	commonArgs = append(commonArgs, "-l", filepath.Join(pb.config.FileListDir(), "Android.bp.list"))
 	invocationEnv := make(map[string]string)
+	// Honor opt-in Go runtime limits when bootstrap clears the environment.
+	for _, name := range []string{"GOGC", "GOMEMLIMIT", "GOMAXPROCS"} {
+		if value := os.Getenv(name); value != "" {
+			invocationEnv[name] = value
+		}
+	}
 	if pb.debugPort != "" {
 		//debug mode
 		commonArgs = append(commonArgs, "--delve_listen", pb.debugPort,
